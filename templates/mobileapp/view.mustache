{{=<% %>=}}
<core-loading [hideUntil]="loaded">
    <ion-content>
        <div class="certificatebeautiful-mobile-container" style="height: 100vh; width: 100%;">
            <iframe
                [src]="src"
                frameborder="0"
                style="width: 100%; height: 100%; border: none;"
                (load)="loaded = true">
            </iframe>
        </div>
    </ion-content>
</core-loading>
